#:import config kiosk.config
#:import icons kiosk.icons

# Ekran aplikacji testowej domofonu: czarne tło, "Przytrzymaj i mów", ostatnia wiadomość
<IntercomRoot>:
    orientation: "vertical"
    padding: [24, 16, 24, 24]
    spacing: 10
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        size_hint_y: None
        height: 64
        spacing: 16
        Icon:
            icon: "phone"
            font_size: "36sp"
            color: config.COLOR_ACCENT
            size_hint_x: None
            width: 48
        Label:
            text: "Domofon - " + app.tablet_name
            font_size: "26sp"
            text_size: self.size
            halign: "left"
            valign: "middle"
        Label:
            text: app.ha_url
            font_size: "15sp"
            color: config.COLOR_TEXT_DIM
            text_size: self.size
            halign: "right"
            valign: "middle"

    Label:
        text: "{} s".format(int(root.remaining)) if root.recording else "maks. {} s".format(int(root.max_seconds))
        font_size: "64sp" if root.recording else "26sp"
        bold: root.recording
        color: (0.95, 0.35, 0.35, 1) if root.recording else config.COLOR_TEXT_DIM
        size_hint_y: None
        height: 90

    AnchorLayout:
        TalkButton:
            active: root.recording
            enabled: root.can_record
            on_press: root.press()
            on_release: root.release()

    Label:
        text: root.status
        font_size: "22sp"
        size_hint_y: None
        height: 40

    BoxLayout:
        size_hint_y: None
        height: 64
        spacing: 16
        opacity: 1 if app.voice_last else 0
        disabled: not app.voice_last
        Widget:
        Label:
            text: "Ostatnia wiadomość: " + app.voice_last
            font_size: "19sp"
            color: config.COLOR_TEXT_DIM
            size_hint_x: None
            width: self.texture_size[0]
        SettingsButton:
            icon: "play"
            text: "Odtwórz ponownie"
            pos_hint: {"center_y": 0.5}
            on_release: root.replay()
        Widget:

# Przycisk menu po prawej (dom - domofon, pad - gry); code - znak z czcionki ikon
<IntercomRailButton@ButtonBehavior+AnchorLayout>:
    code: 0
    target: ""
    size_hint_y: None
    height: 110
    on_release: app.nav(self.target)
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.20) if self.state == "down" else (1, 1, 1, 0.07)
        RoundedRectangle:
            pos: self.center_x - 44, self.center_y - 44
            size: 88, 88
            radius: [26]
    Label:
        text: chr(root.code)
        font_name: icons.FONT_NAME
        font_size: "52sp"
        color: 1.0, 0.84, 0.40, 1
        size_hint: None, None
        size: self.texture_size

# Całe okno: ekrany (domofon i gry z dzieci/games/gry.kv) oraz menu po prawej
<IntercomMain@BoxLayout>:
    orientation: "horizontal"
    ScreenManager:
        id: sm
        Screen:
            name: "start"
            IntercomRoot:
                id: talk
        GamesScreen:
        TicTacToeScreen:
        CheckersScreen:
        ChessScreen:
        DiceScreen:
        PaintScreen:
        DotsScreen:
        ShipsScreen:
        PolishDotsScreen:
        TetrisScreen:
        SnakeScreen:
        FootballScreen:
        MusicScreen:
        ColoringScreen:
        ColorPageScreen:
    BoxLayout:
        orientation: "vertical"
        size_hint_x: None
        width: 128
        padding: [0, 18]
        spacing: 6
        canvas.before:
            Color:
                rgba: 0.16, 0.19, 0.29, 1
            Rectangle:
                pos: self.pos
                size: self.size
        IntercomRailButton:
            # phone - ekran domofonu
            code: 0xF03F2
            target: "home"
        IntercomRailButton:
            # gamepad-variant - siatka gier
            code: 0xF0297
            target: "games"
        IntercomRailButton:
            # music - piosenki dla dzieci
            code: 0xF075A
            target: "music"
        IntercomRailButton:
            # palette - kolorowanki
            code: 0xF03D8
            target: "coloring"
        Widget:
        IntercomRailButton:
            # exit-run - wyjście z aplikacji (3 razy „Tak”)
            code: 0xF0425
            target: "exit"
